# Stock Market Monitor - Environment Configuration

# API Keys (Optional - for live data)
# Leave empty to use mock data (recommended for demo)

# Finnhub - Free tier: 60 API calls/minute
# Get key: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# IEX Cloud - Free tier: 100 messages/month
# Get key: https://iexcloud.io/
IEX_API_KEY=your_iex_key_here

# Polygon.io - Free tier: 5 API calls/minute
# Get key: https://polygon.io/
POLYGON_API_KEY=your_polygon_key_here

# Alpha Vantage - Free tier: 5 API calls/minute
# Get key: https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# Email Alerts (Optional)
ALERT_EMAIL=your_email@example.com
EMAIL_PASSWORD=your_app_password

# Monitoring Settings (Optional)
UPDATE_INTERVAL=60
LOG_LEVEL=INFO
